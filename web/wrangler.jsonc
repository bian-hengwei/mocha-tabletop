{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mocha-tabletop",
  "account_id": "739a92e6dbee65abfd9a45370b68e84f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "RoomDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom",
        "RoomDirectory"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://mocha-tabletop-web.pages.dev,https://mocha-tabletop.bianhengwei.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://play.bianhengwei.com"
  }
}
